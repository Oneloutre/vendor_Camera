// Rule to merge GoogleCamera.apk parts into a single APK
genrule {
    name: "merge_google_camera_b1c1",
    srcs: [
        "*.part", // Matches all files ending with .part
    ],
    out: ["GoogleCamera_b1c1.apk"],
    cmd: "cat $(in) > $(out)",
}

// Import GoogleCamera
android_app_import {
    name: "GoogleCamera_b1c1",
    apk: ":merge_google_camera_b1c1", // Reference the output of the genrule
    certificate: "platform",
    owner: "google",
    overrides: [
        "Snap",
        "Camera2",
        "Aperture",
        "GCamGOPrebuilt-V3",
    ],
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
}
